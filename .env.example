# =========================================================
# Email Campaign Manager — environment template
# Copy to .env and fill in real values. Never commit .env.
# =========================================================

# --- Runtime mode ---
# "production" | "development" | "test". Unset means development.
# Any other value fails startup validation; production is never assumed.
NODE_ENV="development"

# --- Database (Prisma/PostgreSQL) ---
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DBNAME"

# --- Google OAuth ---
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
# Required and must be HTTPS when NODE_ENV=production.
GOOGLE_CALLBACK_URL="http://localhost:3000/auth/google/callback"

# --- Session (Redis-backed express-session) ---
# Required: at least 32 random characters. Generate with:
#   openssl rand -hex 32
SESSION_SECRET="change-me-to-a-long-random-secret-string"

# --- Redis ---
REDIS_HOST="127.0.0.1"
REDIS_PORT="6379"
REDIS_PASSWORD=""

# --- App ---
# Frontend origin (or CORS_ORIGIN) must be set explicitly in production;
# the localhost fallback only applies in development.
FRONTEND_URL="http://localhost:5173"
# Optional override; when set, wins over FRONTEND_URL. "*" is never allowed.
CORS_ORIGIN=""

# --- Email provider ---
# Defaults to "brevo" (Transactional Email HTTP API). Set to "gmail" to use
# the legacy Nodemailer/SMTP fallback.
EMAIL_PROVIDER="brevo"

# --- Gmail SMTP (legacy fallback) ---
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-smtp-email"
SMTP_PASS="your-app-password"
SMTP_SECURE="false"

# --- Brevo (Transactional Email API) ---
# Real Brevo HTTP API integration: one POST per batch job to
# https://api.brevo.com/v3/smtp/email authenticated with api-key.
BREVO_API_KEY=""

# Shared secret for the /api/webhooks/brevo endpoint. Required at startup and
# every webhook request must present it (Authorization: Bearer, x-brevo-token,
# or ?token= query param). Generate with: openssl rand -hex 32
BREVO_WEBHOOK_TOKEN=""

# Sender address/name are required when EMAIL_PROVIDER=brevo. The sender must
# be a verified address or domain in your Brevo account or sends will be rejected.
BREVO_SENDER_EMAIL=""
BREVO_SENDER_NAME="Email Campaign Manager"

# Brevo daily sending ceiling per campaign (positive integer).
# Campaigns larger than this are split into multiple sendEmailBatch jobs,
# one per day (batch index * 24h delay). Invalid values fall back to 300.
DAILY_EMAIL_LIMIT="300"

# --- Frontend (Vite) ---
VITE_API_BASE_URL="http://localhost:3000"
