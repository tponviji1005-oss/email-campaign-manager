# =========================================================
# Email Campaign Manager — environment template
# Copy to .env and fill in real values. Never commit .env.
# =========================================================

# --- Database (Prisma/PostgreSQL) ---
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DBNAME"

# --- Google OAuth ---
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# --- Session (Redis-backed express-session) ---
SESSION_SECRET="change-me"

# --- Redis ---
REDIS_HOST="127.0.0.1"
REDIS_PORT="6379"
REDIS_PASSWORD=""

# --- App ---
FRONTEND_URL="http://localhost:5173"

# --- Email provider ---
# Defaults to "brevo" (Transactional Email HTTP API). Set to "gmail" to use
# the legacy Nodemailer/SMTP fallback.
EMAIL_PROVIDER="brevo"

# --- Gmail SMTP (legacy fallback) ---
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-smtp-email"
SMTP_PASS="your-app-password"
SMTP_SECURE="false"

# --- Brevo (Transactional Email API) ---
# Real Brevo HTTP API integration: one POST per batch job to
# https://api.brevo.com/v3/smtp/email authenticated with api-key.
BREVO_API_KEY=""

# Optional overrides. When unset the app uses the verified default sender:
# sender email  -> tponviji1005@gmail.com
# sender name   -> Email Campaign Manager
BREVO_SENDER_EMAIL=""
BREVO_SENDER_NAME=""

# Brevo daily sending ceiling per campaign (positive integer).
# Campaigns larger than this are split into multiple sendEmailBatch jobs,
# one per day (batch index * 24h delay). Invalid values fall back to 300.
DAILY_EMAIL_LIMIT="300"

# --- Frontend (Vite) ---
VITE_API_BASE_URL="http://localhost:3000"
